{
  "name": "omp-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial macOS, Windows, and WSL desktop client for Oh My Pi",
  "license": "MIT",
  "main": "out/main/index.js",
  "author": "Eijnewgnaw and OMP Desktop contributors",
  "homepage": "https://github.com/Eijnewgnaw/omp-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Eijnewgnaw/omp-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Eijnewgnaw/omp-desktop/issues"
  },
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:integration": "OMP_INTEGRATION=1 vitest run tests/omp-rpc.integration.test.ts",
    "test:e2e": "npm run build && node tests/visual.e2e.mjs",
    "test:e2e:resume": "npm run build && node tests/resume.e2e.mjs",
    "test:e2e:profile": "npm run build && node tests/profile.e2e.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "io.github.eijnewgnaw.ompdesktop",
    "productName": "OMP Desktop",
    "artifactName": "OMP-Desktop-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "OMP Desktop ${version}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
